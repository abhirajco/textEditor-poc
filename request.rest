# ============================================================
#  Merged Platform — REST Client
#  VS Code REST Client extension required
#  All seeded passwords: Pass123!
# ============================================================

@base     = http://127.0.0.1:8000/api
@password = Pass123!

@articleId = 1

@versionId = 1

@commentId =1
# ============================================================
#  1. AUTH FLOW
# ============================================================

### 1a. Signup (sends OTP to email)
POST {{base}}/accounts/signup/
Content-Type: application/json

{
  "email":     "newuser@example.com",
  "full_name": "New User",
  "password":  "Pass123!"
}

### 1b. Verify OTP (check terminal for code, completes registration)
POST {{base}}/accounts/verify-otp/
Content-Type: application/json

{
  "email": "newuser@platform.com",
  "otp":   "441920"
}

###
POST {{base}}/accounts/login/
Content-Type: application/json

{
  "email":    "newuser@example.com",
  "password": "{{password}}"
}

### 1c. Login as Admin
# @name adminLogin
POST {{base}}/accounts/login/
Content-Type: application/json

{
  "email":    "admin@platform.com",
  "password": "{{password}}"
}

###
@adminToken = {{adminLogin.response.body.access}}
@adminRefresh = {{adminLogin.response.body.refresh}}

### 1d. Login as Executive
# @name execLogin
POST {{base}}/accounts/login/
Content-Type: application/json

{
  "email":    "exec@platform.com",
  "password": "{{password}}"
}
###
@execToken = {{execLogin.response.body.access}}

### 1e. Login as Writer
# @name writerLogin
POST {{base}}/accounts/login/
Content-Type: application/json

{
  "email":    "writer@platform.com",
  "password": "{{password}}"
}

###
@writerToken = {{writerLogin.response.body.access}}

### 1f. Login as Reviewer
# @name reviewerLogin
POST {{base}}/accounts/login/
Content-Type: application/json

{
  "email":    "reviewer@platform.com",
  "password": "{{password}}"
}

###
@reviewerToken = {{reviewerLogin.response.body.access}}

### 1g. Login as SME
# @name smeLogin
POST {{base}}/accounts/login/
Content-Type: application/json

{
  "email":    "sme@platform.com",
  "password": "{{password}}"
}


###
@smeToken = {{smeLogin.response.body.access}}

### 1h. Logout
POST {{base}}/accounts/logout/
Authorization: Bearer {{writerToken}}
Content-Type: application/json

{
  "refresh": "PASTE_REFRESH_TOKEN_HERE"
}

### 1i. Refresh access token
POST {{base}}/accounts/token/refresh/
Content-Type: application/json

{
  "refresh": "PASTE_REFRESH_TOKEN_HERE"
}


# ============================================================
#  2. ADMIN — USER MANAGEMENT
# ============================================================

### 2a. View all users
GET {{base}}/accounts/users/all/
Authorization: Bearer {{adminToken}}

### 2b. View pending users (role = none, need assignment)
GET {{base}}/accounts/users/pending/
Authorization: Bearer {{adminToken}}

### 2c. Assign group + role to a user
# group choices: admin | executive | internal | external | user
# role choices:  admin | exec_approver | executive | writer | reviewer | sme | none
POST {{base}}/accounts/users/assign/2/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{
  "group": "internal",
  "role":  "writer"
}

### 2d. Delete a user
DELETE {{base}}/accounts/users/delete/5/
Authorization: Bearer {{adminToken}}

### 2e. RBAC audit — see all users and their permission matrix
GET {{base}}/accounts/users/rbac-audit/
Authorization: Bearer {{adminToken}}

### 2f. @Mention user search (used by frontend dropdown for both article comments and task discussion)
# Returns users whose name starts with the query word
GET {{base}}/accounts/users/search/?q=ali
Authorization: Bearer {{adminToken}}

### 2g. Search with multiple words
GET {{base}}/accounts/users/search/?q=b
Authorization: Bearer {{adminToken}}


###

# ============================================================
# CONTENT — ARTICLE SAVE / SUBMIT FLOW
# ============================================================

### Step 1 — Create fresh article (no article_id)
# Auto-locks to writer. Creates draft. Version created in background.
POST {{base}}/content/contents/save/
Authorization: Bearer {{writerToken}}
Content-Type: application/json

{
  "title":   "A fresh content",
  "body": "This is the initial content of the article."
}

###

### Step 2 — Save existing article (update draft, lock already held)
POST {{base}}/content/contents/save/
Authorization: Bearer {{writerToken}}
Content-Type: application/json

{
  "content_id": "78449f51-0dfd-435e-82cc-5109211d03b3",
  "title":  "1st update",
  "body": "Updated body with more detail."
}

###

### Step 3a — Get reviewer dropdown (call before submitting)
GET {{base}}/content/articles/reviewers-list/
Authorization: Bearer {{writerToken}}

###

### Step 3b — Submit for review (writer selects reviewer UUIDs from dropdown)
POST {{base}}/content/articles/save/
Authorization: Bearer {{writerToken}}
Content-Type: application/json

{
  "article_id":      "{{articleId}}",
  "title":           "My First Article — Final",
  "content":         "Final polished content ready for review.",
  "submit":          true,
  "notify_user_ids": ["REVIEWER_UUID_1", "WRITER_UUID_2"]
}

###

# ============================================================
# CONTENT — LOCK
# ============================================================

### Acquire lock (required before editing existing article)
POST {{base}}/content/articles/{{articleId}}/lock/
Authorization: Bearer {{writerToken}}

###

### Release lock
DELETE {{base}}/content/articles/{{articleId}}/lock/
Authorization: Bearer {{writerToken}}

###

# ============================================================
# CONTENT — ARTICLE DETAIL
# ============================================================

### Article detail (latest state)
GET {{base}}/content/contents/9cf1c0c6-32a1-41cf-ab76-bea612929b06/
Authorization: Bearer {{writerToken}}

###

# ============================================================
# CONTENT — VERSIONS
# ============================================================

### List all versions of an article
GET {{base}}/content/contents/78449f51-0dfd-435e-82cc-5109211d03b3/history/
Authorization: Bearer {{writerToken}}

###

### View a SPECIFIC version (full content)
GET {{base}}/content/articles/78449f51-0dfd-435e-82cc-5109211d03b3/versions/0d757b9a-fa69-4f28-9dbc-5abb3ed125bd/
Authorization: Bearer {{reviewerToken}}

###

### Latest version
GET {{base}}/content/articles/{{articleId}}/latest-version/
Authorization: Bearer {{writerToken}}

###

# ============================================================
# CONTENT — APPROVAL WORKFLOW
# ============================================================

### Get notify candidates — who to notify at next stage
### stage options: pending_executive | pending_admin
GET {{base}}/content/articles/{{articleId}}/notify-candidates/?stage=pending_executive
Authorization: Bearer {{reviewerToken}}

###

### Reviewer approves → sends to selected executives
POST {{base}}/content/articles/{{articleId}}/approve/
Authorization: Bearer {{reviewerToken}}
Content-Type: application/json

{
  "notify_user_ids": ["EXEC_UUID_1", "EXEC_UUID_2"]
}

###

### Executive approves → sends to selected admins
GET {{base}}/content/articles/{{articleId}}/notify-candidates/?stage=pending_admin
Authorization: Bearer {{execToken}}

###

POST {{base}}/content/articles/{{articleId}}/approve/
Authorization: Bearer {{execToken}}
Content-Type: application/json

{
  "notify_user_ids": ["ADMIN_UUID_1"]
}

###

### Admin publishes (no notify_user_ids needed)
POST {{base}}/content/articles/{{articleId}}/approve/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{}

###

# ============================================================
# CONTENT — SME
# ============================================================

### Assign SME to article
POST {{base}}/content/articles/{{articleId}}/assign-sme/
Authorization: Bearer {{reviewerToken}}
Content-Type: application/json

{"sme_id": "SME_USER_UUID"}

###

# ============================================================
# CONTENT — COMMENTS
# ============================================================

### Write comment (with @mention)
POST {{base}}/content/articles/{{articleId}}/comment/
Authorization: Bearer {{reviewerToken}}
Content-Type: application/json

{"comment_text": "Great work @[Alice Writer](WRITER_UUID). Please also expand section 2."}

###

### Comment history for an article
GET {{base}}/content/articles/{{articleId}}/comments/history/
Authorization: Bearer {{reviewerToken}}

###

### Edit comment
PATCH {{base}}/content/comments/edit/{{commentId}}/
Authorization: Bearer {{reviewerToken}}
Content-Type: application/json

{"comment_text": "Updated comment text."}

###

### Delete comment
DELETE {{base}}/content/comments/edit/{{commentId}}/
Authorization: Bearer {{reviewerToken}}

###

# ============================================================
# CONTENT — LISTS
# ============================================================

### All active (non-published) articles
GET {{base}}/content/articles/active/
Authorization: Bearer {{writerToken}}

###

### All published articles
GET {{base}}/content/articles/published/
Authorization: Bearer {{writerToken}}

###

# ============================================================
# ACCOUNTS
# ============================================================

### All users
GET {{base}}/accounts/users/all/
Authorization: Bearer {{adminToken}}

###

### Pending users (no role)
GET {{base}}/accounts/users/pending/
Authorization: Bearer {{adminToken}}

###

### Assign role to user
POST {{base}}/accounts/users/assign/USER_UUID/
Authorization: Bearer {{adminToken}}
Content-Type: application/json

{"group": "internal", "role": "writer"}

###

### Search users (for @mention dropdown)
GET {{base}}/accounts/users/search/?q=alice
Authorization: Bearer {{writerToken}}

