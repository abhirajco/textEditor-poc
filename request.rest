### ============================================================
### Content Management API — Full Test Suite
### ============================================================
### Usage: Open in VS Code with REST Client extension
###        or import into Insomnia / Postman
###
### VARIABLES — update these before running
### ============================================================

@baseUrl = http://localhost:8000/api

@boarUrl = {{baseUrl}}/board

@contentUrl = {{baseUrl}}/content

### Auth tokens — obtain from login endpoints
# @writerToken     = Bearer <writer_jwt_token>
# @internalToken   = Bearer <internal_member_jwt_token>
# @executiveToken  = Bearer <executive_jwt_token>
# @adminToken      = Bearer <admin_jwt_token>

### IDs — fill in after running create/list calls
@contentId    = 00000000-0000-0000-0000-000000000000
@campaignId   = 70d98ae1-25fc-4fe6-b519-ac5469f44eda
@eventId      = 1
@versionId    = 00000000-0000-0000-0000-000000000000
@commentId    = 00000000-0000-0000-0000-000000000000
@internalId   = 00000000-0000-0000-0000-000000000000
@executiveId  = 00000000-0000-0000-0000-000000000000
@adminId      = 00000000-0000-0000-0000-000000000000
@smeId        = 00000000-0000-0000-0000-000000000000


### ============================================================
### AUTH — Login to get tokens
### ============================================================

@base     = http://127.0.0.1:8000/api
@password = Pass123!


